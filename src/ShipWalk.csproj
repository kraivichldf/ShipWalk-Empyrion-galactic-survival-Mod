<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ShipWalk</AssemblyName>
    <Version>0.4.13</Version>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <GameRoot Condition="'$(GameRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\</GameRoot>
    <ManagedDir>$(GameRoot)Client\Empyrion_Data\Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Runtime.cs;Hooks.cs;CoastingPhysics.cs;MovingInterior.cs" />
    <PackageReference Include="Lib.Harmony" Version="2.3.6" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="ModApi"><HintPath>$(ManagedDir)\ModApi.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mif"><HintPath>$(ManagedDir)\Mif.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Numerics" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ManagedDir)\ModApi.dll')" Text="Set GameRoot to the installed Empyrion folder (with a trailing separator)." />
  </Target>
</Project>
